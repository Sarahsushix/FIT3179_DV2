{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Breast Screening Participation Across Australia",
    "subtitle": "Women aged 50–74 by SA3 region, 2023–2024",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "middle",
    "offset": 15
  },

  "width": 800,
  "height": 550,

  "data": {
    "url": "data/processed/australia_sa3_simplified.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "transform": [
    {
      "calculate": "datum.properties.SA3_CODE21",
      "as": "sa3_code"
    },
    {
      "lookup": "sa3_code",
      "from": {
        "data": {
          "url": "data/processed/sa3_participation_2023_2024.csv",
          "format": {
            "type": "csv",
            "parse": {
              "SA3_CODE21": "string",
              "participation_rate": "number",
              "participants": "number"
            }
          }
        },
        "key": "SA3_CODE21",
        "fields": [
          "participation_rate",
          "participants",
          "status"
        ]
      }
    }
  ],

  "projection": {
    "type": "mercator"
  },

  "mark": {
    "type": "geoshape",
    "stroke": "white",
    "strokeWidth": 0.3
  },

  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.participation_rate)",
        "field": "participation_rate",
        "type": "quantitative",
        "scale": {
          "scheme": "tealblues",
          "domain": [25, 75]
        },
        "legend": {
          "title": "Participation rate (%)",
          "format": ".0f",
          "orient": "right",
          "gradientLength": 200
        }
      },
      "value": "#D9D9D9"
    },

    "tooltip": [
      {
        "field": "properties.SA3_NAME21",
        "type": "nominal",
        "title": "SA3 Region"
      },
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation (%)",
        "format": ".1f"
      },
      {
        "field": "participants",
        "type": "quantitative",
        "title": "Participants",
        "format": ",.0f"
      },
      {
        "field": "status",
        "type": "nominal",
        "title": "Data Status"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": null
    },
    "background": "white",
    "font": "Arial",
    "legend": {
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  }
}